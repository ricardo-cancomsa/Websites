---
layout: base.njk
---
{%- set toc -%}
<ol>
  {%- for item in content | toc %}
  <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
  {%- endfor %}
</ol>
{%- endset -%}
<h1>{{ title }}</h1>
<p class="version">Version {{ version }} · Last updated: {{ updated }}</p>
<details class="toc">
  <summary>On this page</summary>
  {{ toc | safe }}
</details>
<div class="legal-layout">
  <nav class="toc" aria-label="On this page">
    <p>On this page</p>
    {{ toc | safe }}
  </nav>
  <article class="legal">
    {{ content | safe }}
  </article>
</div>
